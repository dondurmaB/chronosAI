{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/demo_img.jpg",
      "dest": "/public/demo_img.jpg"
    },
    {
      "src": "/logo_img.jpg",
      "dest": "/public/logo_img.jpg"
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
